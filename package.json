{
  "name": "@krantzr/react-native-health",
  "version": "2.0.0",
  "description": "(FORK) A React Native package to interact with Apple HealthKit",
  "main": "index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meter-Health/react-native-health.git"
  },
  "keywords": [
    "Apple",
    "health-kit",
    "healthkit",
    "iOS",
    "react-native",
    "react",
    "native",
    "ios",
    "turbomodule",
    "new-architecture"
  ],
  "bugs": {
    "url": "https://github.com/agencyenterprise/react-native-healthkit/issues"
  },
  "license": "MIT",
  "files": [
    "index.js",
    "index.d.ts",
    "app.plugin.js",
    "src",
    "RCTAppleHealthKit",
    "RCTAppleHealthKit.xcodeproj/project.pbxproj",
    "RNAppleHealthKit.podspec",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "devDependencies": {
    "@expo/config-plugins": "^55.0.0",
    "react-native": ">=0.71.0"
  },
  "peerDependencies": {
    "expo": "*",
    "react-native": ">=0.71.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "RNAppleHealthKitSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "AppleHealthKit": "RCTAppleHealthKit"
      }
    }
  }
}
